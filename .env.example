# Copy to .env (never committed). Leave keys blank to stay on fixtures.
SERV_REASONING_API_KEY=
SERV_BASE_URL=https://inference-api.openserv.ai/v1
# Discover via GET $SERV_BASE_URL/models during API wiring — never inline.
SERV_MODEL=
DOLPHIN_API_KEY=
# Confirmed from https://dphn.ai/docs/dphn-api (2026-11-08). Key: app.dphn.ai -> API Keys.
DOLPHIN_BASE_URL=https://lighthouse.dphn.ai/run/text-v/v1
DOLPHIN_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
KITE_FACILITATOR_URL=
FIANGSHI_PRICE_CHECK=0.05
FIANGSHI_PRICE_CHECK_COLD=0.15
FIANGSHI_POLICY_TTL_HOURS=72
FIANGSHI_MAX_SURF_CALLS=60
# fixture | live
SNAPSHOT_SOURCE=fixture
# good | allow | broken | hallucinated | badquote  (empty = live model)
MOCK_MODELS=good
FIANGSHI_OFFLINE=1
# Budget caps for other providers (guard refuses call N+1). Kite = exactly one real settlement.
FIANGSHI_MAX_SERV_CALLS=100
FIANGSHI_MAX_DOLPHIN_CALLS=200
FIANGSHI_MAX_KITE_CALLS=1
# Model call timeout (SERV + Dolphin); fail closed past it.
FIANGSHI_MODEL_TIMEOUT_MS=15000
# Dolphin: 12 s per attempt, one retry on timeout only, then enrichment:incomplete (optional; never caps the verdict).
FIANGSHI_DOLPHIN_TIMEOUT_MS=12000
# A Dolphin TIMEOUT is remembered this long (seconds), so a slow provider is not re-paid on every check.
FIANGSHI_DOLPHIN_NEGATIVE_TTL_S=3600
# Your own Base wallet that receives x402 payments for /v1/check and /v1/payee (paid endpoints are disabled without it).
# Must pass V6 (not a sink, valid EIP-55). Settlement is dry-run in this build: nothing is ever settled.
FIANGSHI_PAYTO=
FIANGSHI_PRICE_PAYEE=0.02
